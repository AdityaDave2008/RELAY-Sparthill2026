# RELAY mobile app environment.
# Copy to .env (git-ignored). EXPO_PUBLIC_* values are inlined into the client
# bundle — NEVER put AWS credentials or secrets here. Only the backend reads AWS
# credentials.

# Base URL of the RELAY REST API (services/api).
# Local dev server default is http://127.0.0.1:8787. On a physical device,
# 127.0.0.1 is the phone itself — use your machine's LAN IP instead.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8787

# Shared demo device token required by the API outside loopback. This is a demo
# routing credential, not a verified identity.
EXPO_PUBLIC_DEVICE_TOKEN=

# Optional: Amazon Cognito pool for the Amplify UI auth gate. Leave blank to run
# the app without authentication for local/offline demos.
EXPO_PUBLIC_COGNITO_USER_POOL_ID=
EXPO_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=
