RELAY_HOST=127.0.0.1
RELAY_PORT=8787
RELAY_DATA_FILE=./data/relay.json
RELAY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set both tokens before binding outside localhost. Demo access control only.
RELAY_DEVICE_TOKEN=
RELAY_COORDINATOR_TOKEN=
# AWS credentials come from the normal SDK credential chain; never the frontend.
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# Use a Converse-compatible model or inference profile your AWS account can access.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5
# Set when using DynamoDB (including Lambda); otherwise local file storage is used.
RELAY_TABLE_NAME=
